{
  "name": "danangmap-backend",
  "version": "0.1.0",
  "private": true,
  "description": "DanangMap v2 spatial CMS API and worker",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "rimraf dist && tsc -p tsconfig.build.json",
    "start:dev": "tsx watch apps/api/src/main.ts",
    "start:worker:dev": "tsx watch apps/worker/src/main.ts",
    "start:api": "node dist/apps/api/src/main.js",
    "start:worker": "node dist/apps/worker/src/main.js",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write \"{apps,src,scripts,test}/**/*.{ts,json}\" \"*.{json,md,yml,yaml}\"",
    "format:check": "prettier --check \"{apps,src,scripts,test}/**/*.{ts,json}\" \"*.{json,md,yml,yaml}\"",
    "typecheck": "tsc -p tsconfig.build.json --noEmit",
    "test": "jest --runInBand",
    "test:unit": "jest --runInBand --testPathIgnorePatterns=integration-spec --testPathIgnorePatterns=e2e-spec",
    "test:integration": "jest --runInBand --testMatch=\"**/*.integration-spec.ts\"",
    "test:e2e": "jest --runInBand --testMatch=\"**/*.e2e-spec.ts\"",
    "migration:show": "typeorm-ts-node-commonjs -d src/database/data-source.ts migration:show",
    "migration:run": "typeorm-ts-node-commonjs -d src/database/data-source.ts migration:run",
    "migration:revert": "typeorm-ts-node-commonjs -d src/database/data-source.ts migration:revert",
    "migration:run:prod": "typeorm -d dist/src/database/data-source.js migration:run",
    "seed": "tsx scripts/seed.ts",
    "seed:prod": "node dist/scripts/seed.js",
    "openapi:export": "node scripts/export-openapi.mjs",
    "openapi:client": "openapi-typescript openapi/openapi.json -o openapi/generated-client-types.ts",
    "openapi:validate": "node scripts/validate-openapi.mjs",
    "openapi:check": "npm run openapi:export && npm run openapi:client && npm run openapi:validate && git diff --exit-code -- openapi",
    "audit:prod": "npm audit --omit=dev --audit-level=high"
  },
  "dependencies": {
    "@nestjs/bullmq": "^11.0.5",
    "@nestjs/common": "^11.2.1",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.2.1",
    "@nestjs/platform-express": "^11.2.1",
    "@nestjs/swagger": "^11.4.7",
    "@nestjs/typeorm": "^11.0.3",
    "argon2": "^0.45.1",
    "bullmq": "^6.1.2",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "cookie-parser": "^1.4.7",
    "csv-parse": "^7.0.2",
    "dotenv": "^17.4.2",
    "exceljs": "^4.4.0",
    "fast-xml-parser": "^5.11.0",
    "helmet": "^8.3.0",
    "iconv-lite": "^0.7.3",
    "ioredis": "^5.11.1",
    "minio": "^8.0.7",
    "multer": "^2.2.0",
    "otplib": "^13.4.1",
    "pg": "^8.23.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "typeorm": "0.3.31",
    "wkx": "^0.5.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/geojson": "^7946.0.16",
    "@types/jest": "^29.5.14",
    "@types/multer": "^2.2.0",
    "@types/node": "^26.2.0",
    "@types/supertest": "^7.2.1",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "jest": "^29.7.0",
    "jest-util": "^29.7.0",
    "openapi-typescript": "^7.13.0",
    "prettier": "^3.9.6",
    "rimraf": "^6.1.3",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.5",
    "ts-node": "^10.9.2",
    "tsx": "^4.23.12",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.67.0"
  },
  "overrides": {
    "exceljs": {
      "uuid": "^11.1.1"
    }
  }
}
