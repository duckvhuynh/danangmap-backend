  "info": {
    "title": "DanangMap API",
    "description": "DanangMap v2 spatial CMS contract",
    "version": "0.1.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "adminSession": {
        "type": "apiKey",
        "in": "cookie",
        "name": "__Host-danangmap_session"
      },
      "csrf": {
        "type": "apiKey",
        "in": "header",
        "name": "X-CSRF-Token"
      }
    },
    "schemas": {
      "LoginDto": {
        "type": "object",
        "properties": {
          "login": {
            "type": "string",
            "example": "editor@example.gov.vn"
          },
          "password": {
            "type": "string",
            "writeOnly": true
          }
        },
        "required": [
          "login",
          "password"
        ]
      },
      "VerifyMfaDto": {
        "type": "object",
        "properties": {
          "method": {
            "type": "string",
            "enum": [
              "totp",
              "recovery_code"
            ],
            "default": "totp"
          },
          "code": {
            "type": "string",
            "writeOnly": true
          }
        },
        "required": [
          "method",
          "code"
        ]
      },
      "CreateUserDto": {
        "type": "object",
        "properties": {}
      },
      "CreateInviteDto": {
        "type": "object",
        "properties": {}
      },
      "CreateLayerGroupDto": {
        "type": "object",
        "properties": {}
      },
      "CreateLayerDto": {
        "type": "object",
        "properties": {}
      },
      "FeatureMutationDto": {
        "type": "object",
        "properties": {}
      },
      "UpdateFeatureDto": {
        "type": "object",
        "properties": {}
      },
      "SubmitRevisionDto": {
        "type": "object",
        "properties": {}
      },
      "WorkflowCommentDto": {
        "type": "object",
        "properties": {}
      },
      "RequestChangesDto": {
        "type": "object",
        "properties": {}
      },
      "PublishRevisionDto": {
        "type": "object",
        "properties": {}
      },
      "RollbackDto": {
        "type": "object",
        "properties": {}
      },
      "CreateImportDto": {
        "type": "object",
        "properties": {}
      }
    }
  }
